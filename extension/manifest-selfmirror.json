{
  "manifest_version": 3,
  "name": "SelfMirror",
  "version": "0.1.0",
  "description": "🪞 對鏡問話 — AI 鏡像對話，隱私優先的自我探索",
  "permissions": [
    "activeTab",
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "dist/background/selfmirror-sw.js"
  },
  "action": {
    "default_title": "SelfMirror",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup-selfmirror.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
